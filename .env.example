# Public URL of the site (used for SEO: canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.fdevents.in

# Google Search Console verification code (the content="..." value of the meta tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Password for /admin (manage gallery photos & YouTube videos)
ADMIN_PASSWORD=change-me

# --- Optional: Supabase (when set, the site uses Supabase instead of the local /content folder)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
